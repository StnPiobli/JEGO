# Configuration du serveur JEGO
# Copiez ce fichier en .env et renseignez vos vraies valeurs.
# Le fichier .env ne doit JAMAIS être committé.

PORT=3000

# Base de données PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=jego
DB_USER=postgres
DB_PASSWORD=

# Secret de signature des jetons de session.
# OBLIGATOIRE (24 caractères minimum) : le serveur refuse de démarrer sans.
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Secret de signature des QR codes.
# ATTENTION : ne jamais le changer une fois des billets émis,
# les QR déjà distribués deviendraient invérifiables.
# OBLIGATOIRE (24 caractères minimum).
QR_SECRET=

# Clé Resend pour l'envoi réel des emails
RESEND_API_KEY=

# Identifiant client OAuth Google (type « Application Web » dans la
# console Google Cloud). Public, ce n'est pas un secret, mais il doit être
# EXACTEMENT celui inscrit dans l'appli (jego_mobile/lib/config/auth_google.dart),
# sinon la connexion Google est refusée.
GOOGLE_CLIENT_ID=

# « production » sur le serveur en ligne : seules les adresses de
# CORS_ORIGINES peuvent alors appeler l'API depuis un navigateur.
# En développement, cette machine et le réseau local sont acceptés.
NODE_ENV=
CORS_ORIGINES=

# Relais auxquels on fait confiance pour l'adresse IP du visiteur
# (X-Forwarded-For). Par défaut : cette machine (tunnel, relais web).
TRUST_PROXY=

# Mettre true le jour où MTN MoMo / Orange Money sont réellement branchés :
# le bandeau « paiement de démonstration » disparaît alors de l'appli.
PAIEMENTS_REELS=
